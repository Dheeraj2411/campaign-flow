APP_NAME=CampaignFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=info

# Database (Postgres)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=campaignflow
DB_USERNAME=campaignflow
DB_PASSWORD=secret

# Drivers (Redis)
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Broadcast
BROADCAST_CONNECTION=reverb

# Reverb (WebSockets)
REVERB_APP_ID=123456
REVERB_APP_KEY=campaignflow_key
REVERB_APP_SECRET=campaignflow_secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Meilisearch (Search)
MEILISEARCH_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=campaignflow_master_key_secure_32

# Meta / WhatsApp API
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Telegram API
TELEGRAM_BOT_TOKEN=

# Payments
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@campaignflow.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
